{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://editapp.local/contracts/project-v1.json",
  "title": "EditApp Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["mediaId", "revision", "segments", "uiState"],
  "properties": {
    "mediaId": {"type": "string", "pattern": "^m_[A-Za-z0-9_-]{43}$"},
    "revision": {"type": "integer", "minimum": 0},
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startMs", "endMs"],
        "properties": {
          "startMs": {"type": "integer", "minimum": 0},
          "endMs": {"type": "integer", "minimum": 1},
          "label": {"type": "string", "maxLength": 200}
        }
      }
    },
    "uiState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playheadMs", "zoom", "muted"],
      "properties": {
        "playheadMs": {"type": "integer", "minimum": 0},
        "zoom": {"type": "number", "exclusiveMinimum": 0},
        "muted": {"type": "boolean"}
      }
    }
  }
}

