# Installed as /etc/editapp/editapp.env. Keep mode 0640, root:editapp.
# The server rejects non-loopback listeners. Tailscale Serve is the only proxy.
EDITAPP_LISTEN_ADDR=127.0.0.1:8787
EDITAPP_DATABASE_PATH=/var/lib/editapp/data/editapp.db
EDITAPP_CACHE_DIR=/var/cache/editapp/previews
EDITAPP_EXPORT_DIR=/var/lib/editapp/exports

# Replace the example alias/path with the mounted originals directory. The
# editapp user needs read+traverse only; do not put originals under state dirs.
EDITAPP_MEDIA_ROOTS_JSON={"camera":"/srv/editapp/media"}

EDITAPP_AUTH_MODE=tailscale
EDITAPP_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
EDITAPP_FFMPEG_PATH=/usr/bin/ffmpeg
EDITAPP_FFPROBE_PATH=/usr/bin/ffprobe
EDITAPP_PREVIEW_GLOBAL_LIMIT=2
EDITAPP_PREVIEW_PER_USER_LIMIT=1
EDITAPP_EXPORT_LIMIT=1
EDITAPP_CACHE_MAX_BYTES=21474836480
EDITAPP_PREVIEW_BEFORE_MS=2000
EDITAPP_PREVIEW_AFTER_MS=6000
EDITAPP_PREVIEW_MAX_MS=15000
EDITAPP_PREVIEW_GRID_MS=500

# The current preview runner supports software only. Keep this value unless a
# future release adds and successfully probes a hardware profile.
EDITAPP_ENCODER_PREFERENCE=software
EDITAPP_LOG_LEVEL=info
