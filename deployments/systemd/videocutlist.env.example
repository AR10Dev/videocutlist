# Installed as /etc/videocutlist/videocutlist.env. Keep mode 0640, root:videocutlist.
# Bind loopback by default. A LAN deployment must use an explicit IP literal.
VIDEOCUTLIST_LISTEN_ADDRESS=127.0.0.1
VIDEOCUTLIST_PORT=8787
# VIDEOCUTLIST_PUBLIC_BASE_URL=http://127.0.0.1:8787
# Comma-separated browser origins when the client is hosted elsewhere; no '*'.
# VIDEOCUTLIST_ALLOWED_ORIGINS=https://editor.example.test
VIDEOCUTLIST_DATABASE_PATH=/var/lib/videocutlist/data/videocutlist.db
VIDEOCUTLIST_CACHE_DIR=/var/cache/videocutlist/previews
VIDEOCUTLIST_EXPORT_DIR=/var/lib/videocutlist/exports

# Replace the example alias/path with the mounted originals directory. The
# videocutlist user needs read+traverse only; do not put originals under state dirs.
VIDEOCUTLIST_MEDIA_ROOTS_JSON={"camera":"/srv/videocutlist/media"}

# Choose one: none, bearer, or trusted_proxy.
VIDEOCUTLIST_AUTH_MODE=none
# Bearer mode requires a secret token; keep it out of source control.
# VIDEOCUTLIST_BEARER_TOKEN=replace-with-a-secret
# VIDEOCUTLIST_BEARER_SUBJECT=static-bearer
# trusted_proxy accepts X-Forwarded-User only from these immediate peers.
# VIDEOCUTLIST_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
VIDEOCUTLIST_FFMPEG_PATH=/usr/bin/ffmpeg
VIDEOCUTLIST_FFPROBE_PATH=/usr/bin/ffprobe
VIDEOCUTLIST_PREVIEW_GLOBAL_LIMIT=2
VIDEOCUTLIST_PREVIEW_PER_USER_LIMIT=1
VIDEOCUTLIST_EXPORT_LIMIT=1
VIDEOCUTLIST_CACHE_MAX_BYTES=21474836480
VIDEOCUTLIST_PREVIEW_BEFORE_MS=2000
VIDEOCUTLIST_PREVIEW_AFTER_MS=6000
VIDEOCUTLIST_PREVIEW_MAX_MS=15000
VIDEOCUTLIST_PREVIEW_GRID_MS=500
