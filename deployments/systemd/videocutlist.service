[Unit]
Description=VideoCutlist video preview service
Documentation=file:///opt/videocutlist/current/docs/runbooks/install-arch-cachyos.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/videocutlist/videocutlist.env

[Service]
Type=simple
User=videocutlist
Group=videocutlist
SupplementaryGroups=videocutlist-media
WorkingDirectory=/opt/videocutlist/current
EnvironmentFile=/etc/videocutlist/videocutlist.env
ExecStart=/opt/videocutlist/current/bin/videocutlist
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
UMask=0077
LimitNOFILE=8192
TasksMax=256

# The service writes only its SQLite database, preview cache, and exports.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/videocutlist/data /var/lib/videocutlist/exports /var/cache/videocutlist/previews
ReadOnlyPaths=/srv/videocutlist/media

[Install]
WantedBy=multi-user.target
