# Copy to videocutlist.env. The Compose port binding remains loopback-only by
# default; see docs/runbooks/containers.md before changing the bind address.
# Set VIDEOCUTLIST_MEDIA_DIR to the HOST source directory. The Compose file
# mounts it read-only at /srv/videocutlist/media, the server-visible root below.
# Settings displays safe aliases only; filesystem paths are deployment-owned.
VIDEOCUTLIST_LISTEN_ADDRESS=0.0.0.0
VIDEOCUTLIST_PORT=8787
VIDEOCUTLIST_DATABASE_PATH=/var/lib/videocutlist/data/videocutlist.db
VIDEOCUTLIST_CACHE_DIR=/var/cache/videocutlist/previews
VIDEOCUTLIST_EXPORT_DIR=/var/lib/videocutlist/exports
# The container listener is non-loopback even when Compose publishes locally.
# Generate a secret as described in docs/runbooks/containers.md and append
# VIDEOCUTLIST_BEARER_TOKEN=<generated-secret> to your private videocutlist.env.
VIDEOCUTLIST_AUTH_MODE=bearer
# VIDEOCUTLIST_ALLOWED_ORIGINS=https://editor.example.test
# VIDEOCUTLIST_TRUSTED_PROXY_CIDRS=172.16.0.0/12,127.0.0.0/8,::1/128
# Initial runtime-settings seed. Runtime settings are persisted in the DB;
# later Settings changes take precedence over this value.
VIDEOCUTLIST_MEDIA_ROOTS_JSON={"media":"/srv/videocutlist/media"}
VIDEOCUTLIST_PREVIEW_GLOBAL_LIMIT=2
VIDEOCUTLIST_EXPORT_LIMIT=1
# MCP uses separately issued scoped credentials and remains disabled by default.
VIDEOCUTLIST_MCP_ENABLED=false
VIDEOCUTLIST_CACHE_MAX_BYTES=21474836480
VIDEOCUTLIST_PREVIEW_BEFORE_MS=2000
VIDEOCUTLIST_PREVIEW_AFTER_MS=6000
VIDEOCUTLIST_PREVIEW_MAX_MS=15000
VIDEOCUTLIST_PREVIEW_GRID_MS=500
