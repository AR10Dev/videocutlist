{
  "name": "videocutlist-solid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/compress.mjs",
    "api:generate": "openapi-typescript ../docs/contracts/api.openapi.yaml -o src/generated/api.ts --default-non-nullable false",
    "dev": "vite",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@kobalte/core": "0.13.14",
    "@tanstack/solid-query": "5.104.0",
    "lucide-solid": "1.48.0",
    "motion": "13.4.4",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "daisyui": "5.7.46",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "overrides": {
      "@redocly/openapi-core>js-yaml": "4.3.2"
    }
  }
}
