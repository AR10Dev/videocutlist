{
  "name": "videocutlist-solid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/compress.mjs",
    "dev": "vite",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.1",
    "solid-js": "2.0.0-rc.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@solidjs/vite-plugin": "3.0.0-next.28",
    "@types/node": "26.1.2",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
